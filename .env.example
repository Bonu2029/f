# Copy to .env.local. Everything here is optional — the site runs without it,
# it simply shows less rather than showing something invented.

NEXT_PUBLIC_SITE_URL=https://massielbeautysalon.com

# --- Contact -----------------------------------------------------------------
# Leave unset and the site hides the field entirely rather than publishing a
# number that does not connect.
# NEXT_PUBLIC_PHONE=
# NEXT_PUBLIC_EMAIL=

# --- Address (registry-sourced defaults live in src/lib/site.ts) --------------
# NEXT_PUBLIC_ADDRESS_STREET=
# NEXT_PUBLIC_ADDRESS_CITY=
# NEXT_PUBLIC_ADDRESS_REGION=
# NEXT_PUBLIC_ADDRESS_POSTAL=

# --- Google reviews (Places API New) -----------------------------------------
# Server-side only. Without these the reviews section shows an honest empty
# state — there are no hard-coded testimonials in this codebase.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
# NEXT_PUBLIC_GOOGLE_PROFILE_URL=
# NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# --- Booking delivery (first configured option wins) -------------------------
# RESEND_API_KEY=
# BOOKING_TO_EMAIL=
# BOOKING_FROM_EMAIL=
# BOOKING_WEBHOOK_URL=

# The salon's existing online booking system, used as the fallback CTA.
# NEXT_PUBLIC_BOOKING_URL=

# --- Content flags -----------------------------------------------------------
# Set to true only once the real values are in src/lib/services.ts and site.ts.
# NEXT_PUBLIC_PRICES_VERIFIED=true
# NEXT_PUBLIC_HOURS_VERIFIED=true
# NEXT_PUBLIC_HOURS_JSON=

# --- Social ------------------------------------------------------------------
# NEXT_PUBLIC_INSTAGRAM=
# NEXT_PUBLIC_FACEBOOK=
