# =============================================================================
# AI Front Desk — environment configuration
# Copy to `.env.local` (web) / `.env` (voice worker + scripts). NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser. Everything else is
# server-only and must never be imported from a client component.
# =============================================================================

# -----------------------------------------------------------------------------
# Core application
# -----------------------------------------------------------------------------
# Public origin of the web app. Used for OAuth redirects, Stripe return URLs,
# SMS upload links and webhook callback URLs. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# node environment: development | test | production
NODE_ENV=development

# When true the app uses in-memory / no-op provider adapters instead of calling
# Stripe, Twilio, OpenAI and Google. Everything is visibly labelled "Demo".
# MUST be false in production.
DEMO_MODE=true

# -----------------------------------------------------------------------------
# Supabase (PostgreSQL + Auth + Storage)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only by `npm run db:migrate`.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# Project id used in the SIP URI: sip:$OPENAI_PROJECT_ID@sip.api.openai.com
OPENAI_PROJECT_ID=
# Secret from the OpenAI dashboard webhook configuration (starts with whsec_).
OPENAI_WEBHOOK_SECRET=
# Realtime (voice) model. Configurable so the model can be changed without code edits.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Text model for onboarding extraction, summaries, categorisation.
OPENAI_TEXT_MODEL=gpt-5.1
# Model used to render voice preview samples in the receptionist settings page.
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# -----------------------------------------------------------------------------
# Twilio (telephony + SMS)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Elastic SIP Trunk that routes inbound PSTN calls to OpenAI Realtime.
TWILIO_SIP_TRUNK_SID=
# Optional: TwiML App SID used for browser-originated test calls.
TWILIO_TWIML_APP_SID=
# Optional messaging service for improved SMS deliverability.
TWILIO_MESSAGING_SERVICE_SID=

# -----------------------------------------------------------------------------
# Stripe (billing)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Created by `npm run stripe:setup` — paste the printed ids back in here.
STRIPE_FOUNDER_PRICE_ID=
STRIPE_STANDARD_PRICE_ID=
STRIPE_OVERAGE_PRICE_ID=
# Meter event name used to report overage minutes.
STRIPE_OVERAGE_METER_EVENT=ai_minutes_overage
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Google Calendar OAuth
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# -----------------------------------------------------------------------------
# Cryptography
# -----------------------------------------------------------------------------
# 32-byte key, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used for AES-256-GCM encryption of OAuth tokens at rest.
APP_ENCRYPTION_KEY=
# Secret used to sign public photo-upload tokens (HMAC-SHA256). 32+ random chars.
UPLOAD_TOKEN_SECRET=

# -----------------------------------------------------------------------------
# Voice worker
# -----------------------------------------------------------------------------
# Public URL of the voice worker service (used for health checks from admin).
VOICE_WORKER_URL=http://localhost:8787
# Shared secret authenticating voice-worker -> web internal API calls.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOICE_WORKER_SECRET=
# Base URL the worker uses to reach the web app's internal API.
WEB_INTERNAL_URL=http://localhost:3000
PORT=8787

# -----------------------------------------------------------------------------
# Administration
# -----------------------------------------------------------------------------
# Comma-separated list of emails granted platform super-admin access.
# Authorisation is enforced server-side; this list is never shipped to the browser.
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Email notifications (provider-abstracted; console adapter used when unset)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM="AI Front Desk <no-reply@example.com>"
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Ops
# -----------------------------------------------------------------------------
LOG_LEVEL=info
# Secret required by cron endpoints (usage rollup, reservation expiry).
CRON_SECRET=
