# =============================================================================
# AI Front Desk — environment configuration
#
# Copy to `apps/web/.env.local`. NEVER commit real values.
#
# The location matters: Next.js reads `.env.local` from the app directory, not
# the repository root. Put it at `apps/web/.env.local` and every tool here —
# `npm run dev`, `doctor`, `env:check`, `db:migrate` — reads that one file.
#
# Variables prefixed NEXT_PUBLIC_ are compiled into the browser bundle.
# Everything else is server-only: `src/lib/env.ts` imports `server-only`, so a
# client component that reaches for a secret fails the build instead of leaking
# it. In particular, VAPI_API_KEY must never be given a NEXT_PUBLIC_ prefix.
# =============================================================================

# -----------------------------------------------------------------------------
# Core application
# -----------------------------------------------------------------------------
# Public origin of the app. Used for Stripe return URLs and for the webhook URL
# we register on every Vapi assistant. No trailing slash.
#
# localhost is fine for everything except a real phone call. Vapi posts the
# record of each call to <this>/api/webhooks/vapi from its own servers, so with
# a localhost value that record goes nowhere — the call is answered, the caller
# is dealt with, and the business never sees it. The app refuses to sync a real
# assistant in that state rather than fail silently. For a real call, put a
# public HTTPS origin here (a tunnel, e.g. `cloudflared tunnel --url
# http://localhost:3000`, or your deployed site) and update the receptionist.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# development | test | production
NODE_ENV=development

# When true, every external provider is swapped for a mock adapter: no calls are
# placed, no numbers are bought, no cards are charged. Records created this way
# are flagged `is_demo` and badged in the UI. Forced to false in production
# builds so a misconfigured deploy cannot silently stop working.
DEMO_MODE=true

# -----------------------------------------------------------------------------
# Supabase — database and authentication            [REQUIRED]
# -----------------------------------------------------------------------------
# Project URL: Settings -> API -> Project URL.
# Use the bare origin, e.g. https://abcdefgh.supabase.co — NOT the REST endpoint
# (.../rest/v1/). If you paste the REST URL the API path is stripped for you.
NEXT_PUBLIC_SUPABASE_URL=

# The public, RLS-constrained key. Supabase renamed this concept, so set
# whichever your project issues — the app reads either:
#   new projects: Settings -> API Keys -> publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#   older projects: Settings -> API -> anon public key (a JWT)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security. NEVER prefix this NEXT_PUBLIC_.
# New projects: Settings -> API Keys -> secret key. Older: service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used ONLY by `npm run db:migrate`.
# Settings -> Database -> Connection string -> URI (the session pooler URI works
# too). Not needed at runtime, and not needed at all if you paste
# supabase/migrations/bundle.sql into the dashboard SQL editor instead.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# -----------------------------------------------------------------------------
# Vapi — voice AI and telephony                     [REQUIRED for real calls]
# -----------------------------------------------------------------------------
# Private API key from the Vapi dashboard. SERVER ONLY — every Vapi call in this
# app goes through src/lib/providers/vapi.ts, which is server-only.
VAPI_API_KEY=
# Shared secret we set on each assistant. Vapi echoes it back in the
# `x-vapi-secret` header, which is how /api/webhooks/vapi proves a call report is
# genuine. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAPI_WEBHOOK_SECRET=
# OpenAI model Vapi drives for the conversation. OpenAI is the model provider
# *inside* Vapi — this app holds no OpenAI key of its own.
VAPI_OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Stripe — subscriptions                            [REQUIRED for billing]
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Created by `npm run stripe:setup` — paste the printed ids back in here.
STRIPE_FOUNDER_PRICE_ID=
STRIPE_STANDARD_PRICE_ID=
# Optional: metered price used to bill minutes beyond the plan allowance.
STRIPE_OVERAGE_PRICE_ID=
STRIPE_OVERAGE_METER_EVENT=ai_minutes_overage
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Cryptography                                      [REQUIRED]
# -----------------------------------------------------------------------------
# 32 bytes, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used for AES-256-GCM encryption at rest and to key invitation-token hashes.
APP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Administration
# -----------------------------------------------------------------------------
# Comma-separated emails granted platform admin access to /admin.
# Enforced server-side; this list is never shipped to the browser.
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Email notifications (console adapter is used when no provider is configured)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM="AI Front Desk <no-reply@example.com>"
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Ops
# -----------------------------------------------------------------------------
LOG_LEVEL=info
# Bearer token required by POST /api/cron/maintenance.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Tests (optional)
# -----------------------------------------------------------------------------
# Throwaway Postgres database for the integration suite. When unset those tests
# skip rather than fail.
# TEST_DATABASE_URL=postgresql://localhost:5432/afd_test
