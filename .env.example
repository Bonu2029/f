# Copy to .env.local and fill in. Never commit real values.
# Only NEXT_PUBLIC_* variables reach the browser — no secret may use that prefix.

# Public site configuration
NEXT_PUBLIC_SITE_URL=https://www.lumanest.example

# Database and auth (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Payments (server-side only; the publishable key is safe to expose)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Transactional email (server-side only)
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# SMS arrival updates (server-side only)
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# Photo storage for approved uploads (server-side only)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
