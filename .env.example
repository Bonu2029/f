# ---------------------------------------------------------------------------
# ServiceTag environment
#
# Copy to .env.local and fill in. Never commit real values.
# Only NEXT_PUBLIC_* variables reach the browser; everything else is
# server-only and must stay out of client components.
# ---------------------------------------------------------------------------

# Public URL of this deployment. Used to build the URL written to NFC chips.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# Project URL and anon key are safe to expose; row level security protects the
# data. The service role key must never be exposed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Recurring price IDs, one per plan in src/config/pricing.ts.
NEXT_PUBLIC_STRIPE_PRICE_STARTER=
NEXT_PUBLIC_STRIPE_PRICE_BUSINESS=
NEXT_PUBLIC_STRIPE_PRICE_PRO=
